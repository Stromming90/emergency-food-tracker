<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="win.strommingflix.eft"
    android:versionCode="37"
    android:versionName="2.12.5">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v2.12.5: JobScheduler connectivity constraint requires this.
         Without it the schedule call throws SecurityException (the
         crash reported on Android 16) and no background job exists. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2.12.4: lets the installer prompt for this app's own updates -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Food Tracker"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link so a browser-completed SSO login can return to the app.
                 Set the tracker's OIDC redirect URI to
                 win.strommingflix.eft://oidc/callback to use it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="win.strommingflix.eft"
                      android:host="oidc" android:path="/callback" />
            </intent-filter>
        </activity>
        <!-- v2.12.4: hands the downloaded update APK to the installer -->
        <provider
            android:name=".APKProvider"
            android:authorities="win.strommingflix.eft.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- v2.12.0: periodic background check for native notifications -->
        <service
            android:name=".PollJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
